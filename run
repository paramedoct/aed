#!/usr/bin/env bash
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=utils/source.sh
source "$ROOT_DIR/utils/source.sh"
source_modules \
  utils/config.sh \
  utils/time.sh \
  utils/network.sh \
  utils/journal \
  utils/host \
  utils/docker

main() {
  local result=0
  if [ "$#" -eq 1 ] && [ "$1" = --system ] && [ "$EUID" -eq 0 ]; then
    host_apply_recipe
    return "$?"
  fi
  [ "$#" -eq 0 ] || { echo 'Usage: ./run' >&2; return 2; }
  host_apply_recipe || result=$?
  docker_apply_recipe || result=$?
  return "$result"
}

main "$@"
