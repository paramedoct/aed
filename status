#!/usr/bin/env bash
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=utils/source.sh
source "$ROOT_DIR/utils/source.sh"
source_modules \
  utils/time.sh \
  utils/network.sh \
  utils/host \
  utils/docker

main() {
  local result=0
  [ "$#" -eq 0 ] || { echo 'Usage: ./status' >&2; return 2; }
  docker_status || result=2
  host_status || result=2
  return "$result"
}

main "$@"
