#!/usr/bin/env bash
# Mock functions are called indirectly by the sourced modules.
# shellcheck disable=SC2329
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# shellcheck source=utils/source.sh
source "$ROOT_DIR/utils/source.sh"
source_modules utils/config.sh utils/journal utils/host
TEST_DIR=$(mktemp -d)
trap 'rm -rf -- "$TEST_DIR"' EXIT
JOURNAL_CONFIG_DIR="$TEST_DIR/journald.conf.d"
TEST_TRACE="$TEST_DIR/trace"
TEST_RESTART_RESULT=0 TEST_FLUSH_RESULT=0 TEST_USAGE_RESULT=0 TEST_LOAD=loaded

systemctl() {
  printf 'systemctl %s\n' "$*" >> "$TEST_TRACE"
  case "$1" in
    show) printf '%s\n' "$TEST_LOAD" ;;
    restart) return "$TEST_RESTART_RESULT" ;;
    *) return 99 ;;
  esac
}

journalctl() {
  printf 'journalctl %s\n' "$*" >> "$TEST_TRACE"
  case "$1" in
    --flush) return "$TEST_FLUSH_RESULT" ;;
    --disk-usage) echo 'Journal usage'; return "$TEST_USAGE_RESULT" ;;
    --list-boots) echo 'Boot history' ;;
    *) return 99 ;;
  esac
}

journal_test_failure() {
  local expected=$1 actual=0
  shift
  "$@" > "$TEST_DIR/output" 2> "$TEST_DIR/error" || actual=$?
  [ "$actual" -eq "$expected" ] || {
    echo "Expected status $expected, got $actual: $*" >&2; exit 1;
  }
}

journal_test_config() {
  local mode value key
  config_load "$ROOT_DIR/aed.conf"
  journal_recipe_validate
  [ "$JOURNAL_STORAGE" = persistent ]
  printf 'TIMEZONE=UTC\nSYNC_TIMEOUT=60\n' > "$TEST_DIR/old.conf"
  config_load "$TEST_DIR/old.conf"
  journal_recipe_validate
  [ -z "$JOURNAL_STORAGE$JOURNAL_SYSTEM_MAX_USE$JOURNAL_SYSTEM_KEEP_FREE$JOURNAL_MAX_RETENTION_SEC" ]
  journal_preflight
  journal_apply_recipe
  [ ! -e "$TEST_TRACE" ] && [ ! -d "$JOURNAL_CONFIG_DIR" ]
  JOURNAL_SYSTEM_MAX_USE=200M
  journal_test_failure 2 journal_recipe_validate
  config_load "$ROOT_DIR/aed.conf"
  for mode in persistent volatile auto none; do
    JOURNAL_STORAGE=$mode
    journal_recipe_validate
  done
  for value in 0 1024 200K 200M 2G 1T 1P 1E; do
    JOURNAL_SYSTEM_MAX_USE=$value JOURNAL_SYSTEM_KEEP_FREE=$value
    journal_recipe_validate
  done
  for value in 0 60 1s 5min 24h 30day 1week 1month 1year; do
    JOURNAL_MAX_RETENTION_SEC=$value
    journal_recipe_validate
  done
  for key in JOURNAL_STORAGE JOURNAL_SYSTEM_MAX_USE JOURNAL_SYSTEM_KEEP_FREE JOURNAL_MAX_RETENTION_SEC; do
    for value in invalid -1 '1 M' '1; true' $'200M\nStorage=none'; do
      config_load "$ROOT_DIR/aed.conf"
      printf -v "$key" '%s' "$value"
      journal_test_failure 2 journal_recipe_validate
    done
    cat "$ROOT_DIR/aed.conf" > "$TEST_DIR/duplicate.conf"
    printf '%s=persistent\n' "$key" >> "$TEST_DIR/duplicate.conf"
    journal_test_failure 2 config_load "$TEST_DIR/duplicate.conf"
  done
  echo 'PASS: configuration compatibility, modes, units and invalid values'
}

journal_test_apply() {
  local mode
  config_load "$ROOT_DIR/aed.conf"
  journal_preflight
  : > "$TEST_TRACE"
  journal_apply_recipe > "$TEST_DIR/output"
  printf '[Journal]\nStorage=persistent\nSystemMaxUse=200M\nSystemKeepFree=500M\nMaxRetentionSec=30day\n' > "$TEST_DIR/expected"
  diff -u "$TEST_DIR/expected" "$JOURNAL_CONFIG_DIR/90-aed.conf"
  [ "$(stat -c '%a' "$JOURNAL_CONFIG_DIR/90-aed.conf")" = 644 ]
  printf 'systemctl restart systemd-journald.service\njournalctl --flush\njournalctl --disk-usage\njournalctl --list-boots --no-pager\n' > "$TEST_DIR/expected"
  diff -u "$TEST_DIR/expected" "$TEST_TRACE"
  echo 'Unrelated configuration' > "$JOURNAL_CONFIG_DIR/99-local.conf"
  journal_apply_recipe > "$TEST_DIR/output"
  [ "$(cat "$JOURNAL_CONFIG_DIR/99-local.conf")" = 'Unrelated configuration' ]
  for mode in volatile none; do
    JOURNAL_STORAGE=$mode
    JOURNAL_SYSTEM_MAX_USE='' JOURNAL_SYSTEM_KEEP_FREE='' JOURNAL_MAX_RETENTION_SEC=''
    : > "$TEST_TRACE"
    journal_apply_recipe > "$TEST_DIR/output"
    printf '[Journal]\nStorage=%s\n' "$mode" > "$TEST_DIR/expected"
    diff -u "$TEST_DIR/expected" "$JOURNAL_CONFIG_DIR/90-aed.conf"
    if rg -q -- --flush "$TEST_TRACE"; then exit 1; fi
  done
  JOURNAL_STORAGE=auto
  : > "$TEST_TRACE"
  journal_apply_recipe > "$TEST_DIR/output"
  rg -q -- --flush "$TEST_TRACE"
  config_load "$TEST_DIR/old.conf"
  : > "$TEST_TRACE"
  journal_apply_recipe
  [ ! -s "$TEST_TRACE" ]
  rg -q '^Storage=auto$' "$JOURNAL_CONFIG_DIR/90-aed.conf"
  echo 'PASS: atomic configuration, restart, flush, optional settings and skipped changes'
}

journal_test_errors() {
  config_load "$ROOT_DIR/aed.conf"
  TEST_LOAD=not-found
  journal_test_failure 2 journal_preflight
  TEST_LOAD=masked
  journal_test_failure 2 journal_preflight
  TEST_LOAD=loaded
  TEST_RESTART_RESULT=1
  : > "$TEST_TRACE"
  journal_test_failure 1 journal_apply_recipe
  if rg -q '^journalctl ' "$TEST_TRACE"; then exit 1; fi
  rg -q '^Storage=persistent$' "$JOURNAL_CONFIG_DIR/90-aed.conf"
  TEST_RESTART_RESULT=0 TEST_FLUSH_RESULT=1
  journal_test_failure 1 journal_apply_recipe
  rg -q 'Failed to flush' "$TEST_DIR/error"
  TEST_FLUSH_RESULT=0 TEST_USAGE_RESULT=1
  : > "$TEST_TRACE"
  journal_test_failure 2 journal_status
  rg -q -- --list-boots "$TEST_TRACE"
  TEST_USAGE_RESULT=0
  cp "$JOURNAL_CONFIG_DIR/90-aed.conf" "$TEST_DIR/saved"
  (
    chmod() { return 1; }
    : > "$TEST_TRACE"
    journal_test_failure 1 journal_apply_recipe
    diff -u "$TEST_DIR/saved" "$JOURNAL_CONFIG_DIR/90-aed.conf"
    [ ! -s "$TEST_TRACE" ]
    for temporary in "$JOURNAL_CONFIG_DIR"/.90-aed.conf.*; do
      [ ! -e "$temporary" ]
    done
  )
  echo 'PASS: unavailable service, restart/flush/status failures and failed write preservation'
}

journal_test_host_status() {
  (
    host_available() { return 0; }
    time_require() { return 1; }
    network_require() { return 1; }
    : > "$TEST_TRACE"
    journal_test_failure 2 host_status
    rg -q -- --disk-usage "$TEST_TRACE"
    rg -q -- --list-boots "$TEST_TRACE"
  )
  echo 'PASS: journal status remains available when other host checks fail'
}

main() {
  journal_test_config
  journal_test_apply
  journal_test_errors
  journal_test_host_status
}

main "$@"
